# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
cinder-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# Local env (the quickstart puts SECRET_KEY_BASE here — never commit it)
.env

# Personal agent-client layer
/.claude/

# Nix / direnv
.direnv/
result

# graphify tool output (stale-prone, regenerated locally)
graphify-out/

# ElixirLS compiles the project into its own build dir on the first language-server
# request. Not _build, not shared with `mix`, and regenerated on demand.
.elixir_ls/

# Isolated feature worktrees
.worktrees/

# Local database backups. *.db above does not cover these: the app writes .sqlite3,
# and a backup carries users, session tokens and Cloak-encrypted settings.
backups/
*.sqlite3
*.sqlite3-*
