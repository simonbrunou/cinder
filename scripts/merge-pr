#!/usr/bin/env bash
# Merge a Cinder PR on Forgejo under AGENTS.md "Merge authority", pinned to the CI-tested head.
#
#   scripts/merge-pr [--dry-run] [--body-from=<sha> | --body-file=<file>] <pr-number> [squash|rebase|merge]
#
# The style defaults to squash, which keeps main linear with one `<title> (#n)` commit per PR;
# rebase keeps a stacked queue's CI-tested commits as they are. A squash of one non-merge commit
# takes that commit's body, and prints which one. A squash of several stops, lists them and
# shows the first one's message, until it gets --body-from or --body-file (on the dry run too):
# after review or CI commits, the first message can describe a diff the PR no longer has.
# --body-from takes the body of the commit it names, which must be one of the non-merge commits
# in origin/main..<head>: the first one when its message still holds, or the PR's own fix when
# the branch carries another PR's commits first. --body-file takes a body that describes the
# final diff: rewording the commit would need a push and a new CI run. Only a squash takes
# either, and only one of them.
#
# It stops at the first check that fails:
#   1. the PR is open against main; its head SHA comes from the API, never from a local branch;
#      a squash's PR title does not already end in another number, such as its issue's `(#n)`,
#      since the squash appends the PR's own; after `git fetch origin`, this checkout's
#      scripts/merge-pr and scripts/merge-fences equal origin/main's. It stops on any difference:
#      an older copy, from a branch cut before a check reached main, leaves that check out (on
#      #1746, #1743's migration check), and a copy the PR or a local edit changed is not main's
#      yet. Checks 3 to 5 compare them again with the origin/main SHA they read;
#   2. CI is green on that SHA: every job of the head's .forgejo/workflows/ci.yml reports success
#      as `<workflow> / <job> (pull_request)`, and the combined status is success. The container
#      job may report skipped instead (#1486), when the head's ci.yml has the image-inputs job and
#      the head, diffed against its merge base with origin/main, changes no path of the head's
#      image-inputs.txt;
#   3. after `git fetch origin`, `git merge-tree --write-tree origin/main <sha>` exits 0;
#   4. a diff that touches CHANGELOG.md already contains origin/main (merge it in and re-run CI
#      first, since a stale [Unreleased] entry merges cleanly and turns main red);
#   5. every lib/**/*.ex file the PR touches stays within test/code_health_test.exs's @max_lines
#      on the merged tree, and no two files of the merged tree's priv/repo/migrations share a
#      version or a name. Ecto raises on such a pair when both are pending, as on the fresh
#      database of each CI run, and a database that recorded a shared version never runs
#      the other file. Each file there reads <14 digits>_<name>.exs (.formatter.exs aside); the
#      check stops on any other form, on an empty listing and on a failed git ls-tree. These are
#      pre-checks beyond AGENTS.md: two PRs that each grow a near-cap file, or each add a
#      migration with one version, pass apart and break main together;
#   6. a squash of several non-merge commits got --body-from or --body-file;
#   7. scripts/merge-fences passes on the head and that origin/main SHA: it runs the fences
#      (tests that scan the sources) either side changed since the merge-base, with `mix test`
#      on the merged tree in a temporary worktree, unless the head already contains origin/main.
#      Its header says what it selects and how it runs them. It takes 1 to 5 minutes when it runs
#      any, so give a foreground call a 600 s timeout.
# Then it POSTs the merge with head_commit_id (Forgejo answers 409 when the branch moved after
# CI) and delete_branch_after_merge, retries a 405 every 20 s, 15 times at most, re-running
# checks 3 to 5 before each attempt and check 7 when the merged tree changed since its last pass,
# and asserts the PR reports merged.
#
# It cannot check the first Merge authority condition. Run it only once a code review ran on the
# diff (the `code-review` skill or the `pr-review-toolkit:code-reviewer` agent) and its real
# findings are fixed. --dry-run runs every check and stops before the POST.
#
# The token is the one `fj` stores (docs/agents/issue-tracker.md). It is never printed and never
# put on a command line.
set -euo pipefail

api_root=https://git.sbrn.eu/api/v1/repos/simonbrunou/cinder
keys=$HOME/.local/share/forgejo-cli/keys.json

usage() {
  sed -n '4p' "$0" | sed 's/^#   //' >&2
  exit 2
}

dry_run=false
body_from=
body_file=
args=()
for arg in "$@"; do
  case $arg in
    --dry-run) dry_run=true ;;
    --body-from=?*) body_from=${arg#--body-from=} ;;
    --body-file=?*) body_file=${arg#--body-file=} ;;
    -h | --help) usage ;;
    *) args+=("$arg") ;;
  esac
done
[[ ${#args[@]} -ge 1 && ${#args[@]} -le 2 ]] || usage
pr=${args[0]}
style=${args[1]:-squash}
[[ $pr =~ ^[0-9]+$ ]] || usage
case $style in
  squash | rebase | merge) ;;
  *) usage ;;
esac

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

[[ -z $body_from || $style == squash ]] || fail "--body-from applies to a squash, not to $style"
[[ -z $body_file || $style == squash ]] || fail "--body-file applies to a squash, not to $style"
[[ -z $body_from || -z $body_file ]] || fail "pass --body-from or --body-file, not both"
# Read before the cd below, so a relative path names the caller's file.
if [[ -n $body_file ]]; then
  [[ -r $body_file && ! -d $body_file ]] || fail "--body-file: $body_file is not a readable file"
  body_text=$(<"$body_file") || fail "--body-file: $body_file could not be read"
  while [[ $body_text =~ ^[[:space:]]*$'\n' ]]; do body_text=${body_text#*$'\n'}; done
  [[ $body_text == *[![:space:]]* ]] || fail "--body-file: $body_file is blank"
fi

cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

token=$(jq -r '.hosts["git.sbrn.eu"].token // empty' "$keys" 2>/dev/null || true)
[[ -n $token ]] || fail "no git.sbrn.eu token in $keys (log in with fj first)"

# api METHOD PATH [JSON]: sets http_status and http_body.
api() {
  local data=()
  [[ $# -ge 3 ]] && data=(-H 'Content-Type: application/json' --data "$3")
  local out
  out=$(curl -sS --max-time 60 -X "$1" -w '\n%{http_code}' \
    -H @<(printf 'Authorization: token %s\n' "$token") ${data[@]+"${data[@]}"} "$api_root$2") ||
    fail "$1 $2: curl failed"
  http_status=${out##*$'\n'}
  http_body=${out%$'\n'*}
}

# 1. The PR and its head.
api GET "/pulls/$pr"
[[ $http_status == 200 ]] || fail "GET /pulls/$pr answered $http_status"
read -r state merged base sha < <(jq -r '"\(.state) \(.merged) \(.base.ref) \(.head.sha)"' <<<"$http_body")
title=$(jq -r .title <<<"$http_body")
title=${title%"${title##*[![:space:]]}"}
[[ $state == open && $merged == false ]] || fail "#$pr is $state (merged: $merged)"
[[ $base == main ]] || fail "#$pr targets $base, not main"
echo "#$pr: $title"
echo "head: $sha"
# main's subjects end in the PR number alone; `fix: x (#779) (#949)` names the issue twice over.
# The squash below keeps a title's own `(#pr)`, so the check looks at what comes before it.
if [[ $style == squash && ${title%"(#$pr)"} =~ \(#([0-9]+)\)[[:space:]]*$ ]]; then
  bare=$(sed -E 's/[[:space:]]*\(#[0-9]+\)[[:space:]]*$//' <<<"${title%"(#$pr)"}")
  fail "the title ends in (#${BASH_REMATCH[1]}), and the squash appends (#$pr). Retitle it with: fj pr -R origin edit $pr title \"$bare\" (give the title: without one, fj opens an editor). A retitle moves no SHA, so re-run this at once. Keep Closes #${BASH_REMATCH[1]} in the squash body (the fix commit's body or --body-file)."
fi

fetch_head() {
  git fetch -q origin
  git fetch -q origin "refs/pull/$pr/head"
  git cat-file -e "$sha^{commit}" 2>/dev/null || fail "$sha is not fetchable from origin"
}
fetch_head

# This checkout runs the copy of the merge scripts that the commit $1 holds (origin/main here,
# and the origin/main SHA each round of checks 3 to 5 reads).
own_scripts=(scripts/merge-pr scripts/merge-fences)
check_own_scripts() {
  local script
  for script in "${own_scripts[@]}"; do
    git diff --quiet "$1" -- "$script" ||
      fail "$script here differs from origin/main's copy ($(git rev-parse --short "$1")): an older copy leaves out the checks main added since, and any other copy is not main's yet. Commit or copy aside any local edit to them first, since these commands overwrite it. Take main's copies with: git checkout origin/main -- ${own_scripts[*]}, run this again, then put the branch's back with: git checkout HEAD -- ${own_scripts[*]}"
  done
}
check_own_scripts origin/main

# 2. CI on that head. The status contexts come from the head's own ci.yml: the workflow name and
# each job id (a job given a `name:` would report under that name, show as missing, and stop the
# merge).
contexts=$(git show "$sha:.forgejo/workflows/ci.yml" | awk '
  /^name:/ && wf == "" { sub(/^name:[ ]*/, ""); gsub(/"/, ""); wf = $0 }
  /^jobs:/ { jobs = 1; next }
  jobs && /^[^ #]/ { jobs = 0 }
  jobs && /^  [A-Za-z0-9_-]+:[ ]*$/ { id = $1; sub(/:$/, "", id); print wf " / " id " (pull_request)" }')
[[ -n $contexts ]] || fail "no jobs found in $sha:.forgejo/workflows/ci.yml"
api GET "/commits/$sha/status"
[[ $http_status == 200 ]] || fail "GET /commits/$sha/status answered $http_status"
container_skipped=false
inputs_job=false
while IFS= read -r context; do
  status=$(jq -r --arg c "$context" '[.statuses[]? | select(.context == $c) | .status][0] // "missing"' <<<"$http_body")
  echo "$context: $status"
  [[ $context == *" / image-inputs (pull_request)" ]] && inputs_job=true
  case $status in
    success) ;;
    skipped)
      [[ $context == *" / container (pull_request)" ]] || fail "CI is red on $sha ($context: skipped; only the container job may skip)"
      container_skipped=true
      ;;
    pending) fail "CI has not finished on $sha; wait with: python3 -I ~/.agents/skills/forgejo-issues/scripts/forgejo.py ci cinder $sha" ;;
    missing) fail "no '$context' status on $sha; while CI starts, wait with: python3 -I ~/.agents/skills/forgejo-issues/scripts/forgejo.py ci cinder $sha; once it has finished, the job reports under a name: key (see the comment above the contexts)" ;;
    *) fail "CI is red on $sha ($context: $status)" ;;
  esac
done <<<"$contexts"
combined=$(jq -r .state <<<"$http_body")
[[ $combined == success ]] || fail "the combined status of $sha is $combined"

# A skipped container job passes only when the image-inputs job that skips it passed, and the
# head, diffed against its merge base with origin/main over image-inputs.txt as the head has it,
# changes no listed path (check_skip, run with checks 3 to 5 against each origin/main they read).
# The job diffed against the PR's base branch when CI ran, which for a PR retargeted to main from
# another branch was not main. The list is read as the job's step reads it, and a line the step
# would fail on stops here too.
specs=()
if [[ $container_skipped == true ]]; then
  [[ $inputs_job == true ]] || fail "the container job is skipped on $sha, but its ci.yml has no image-inputs job"
  list=$(git show "$sha:image-inputs.txt" 2>/dev/null) || fail "the container job is skipped on $sha, which holds no image-inputs.txt"
  number=0
  # The here-string ends in a newline, so read also reads a last line that has none.
  while IFS= read -r line; do
    number=$((number + 1))
    case $line in
      '' | '#'*) continue ;;
    esac
    if ! [[ $line =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] || [[ "/$line/" == */./* || "/$line/" == */../* ]]; then
      fail "image-inputs.txt:$number at $sha: '$line' is not a path the image-inputs job reads"
    fi
    specs+=(":(literal)$line")
  done <<<"$list"
  [[ ${#specs[@]} -gt 0 ]] || fail "image-inputs.txt at $sha holds no path"
fi

# The skipped container job's diff, against the origin/main that check_against_main read.
check_skip() {
  [[ $container_skipped == true ]] || return 0
  local inputs_base changed
  inputs_base=$(git merge-base "$main_sha" "$sha") || fail "git finds no merge base of origin/main and $sha"
  changed=$(git diff --name-only --no-renames "$inputs_base" "$sha" -- "${specs[@]}") ||
    fail "git cannot diff $inputs_base and $sha"
  [[ -z $changed ]] || fail "the container job is skipped on $sha, but against origin/main it changes these paths of image-inputs.txt: $(tr '\n' ' ' <<<"$changed")
Merge origin/main into the branch and push, so that CI decides against main, then run this again."
  echo "container: skipped, and the head changes no path of image-inputs.txt since $inputs_base"
}

# The fix for two migrations of the merged tree that clash: the PR's side when origin/main lacks
# one of them, and main itself when it holds both.
migration_fix() {
  if git cat-file -e "$main_sha:$1" 2>/dev/null && git cat-file -e "$main_sha:$2" 2>/dev/null; then
    echo "origin/main already holds both, so main itself is broken: fix it there first"
  else
    echo "Fix: $3"
  fi
}

# 3 to 5. The merged tree, against a freshly fetched origin/main. origin/main is read once per
# round: T3 worktrees share origin/* refs, so another thread's fetch can move it mid-check.
# Sets main_sha and tree, which check 7 reads.
check_against_main() {
  local code=0
  main_sha=$(git rev-parse --verify 'origin/main^{commit}') || fail "no origin/main after the fetch"
  check_own_scripts "$main_sha"
  tree=$(git merge-tree --write-tree "$main_sha" "$sha" | sed -n 1p) || code=$?
  case $code in
    0) ;;
    1) fail "$sha conflicts with origin/main: merge origin/main into the branch, run mix test, push, wait for CI" ;;
    *) fail "git merge-tree exited $code (a git error, not a conflict): fetch again and re-run" ;;
  esac
  echo "merge-tree against origin/main $(git rev-parse --short "$main_sha"): clean"

  local changed
  changed=$(git diff --name-only "$main_sha...$sha")
  if grep -qx CHANGELOG.md <<<"$changed"; then
    git merge-base --is-ancestor "$main_sha" "$sha" ||
      fail "the diff touches CHANGELOG.md and the branch lacks origin/main: merge it in, run mix test, push, wait for CI"
    echo "CHANGELOG.md: touched, branch contains origin/main"
  else
    echo "CHANGELOG.md: untouched"
  fi

  local max touched file lines
  max=$(git show "$tree:test/code_health_test.exs" | sed -n 's/^ *@max_lines \([0-9][0-9]*\)$/\1/p')
  [[ -n $max ]] || fail "no @max_lines in test/code_health_test.exs"
  touched=$(git diff --name-only --diff-filter=AMR "$main_sha...$sha" -- 'lib/*.ex')
  while IFS= read -r file; do
    [[ -n $file ]] || continue
    git cat-file -e "$tree:$file" 2>/dev/null || continue
    # code_health_test counts String.split(content, "\n"), one more than wc -l.
    lines=$(($(git show "$tree:$file" | wc -l) + 1))
    ((lines <= max)) || fail "$file has $lines lines on the merged tree, over the $max cap"
  done <<<"$touched"
  echo "line cap: every touched lib/*.ex within $max"

  # Ecto.Migrator raises on a version or a name that two pending files share. Each side's CI
  # migrated one side's files only, so the merged tree is the first to hold both.
  local listing base version name count=0
  local -A versions=() names=()
  listing=$(git ls-tree -r --name-only "$tree" -- priv/repo/migrations) ||
    fail "git cannot list priv/repo/migrations on the merged tree"
  while IFS= read -r file; do
    [[ -n $file && $file != priv/repo/migrations/.formatter.exs ]] || continue
    base=${file#priv/repo/migrations/}
    [[ $base =~ ^([0-9]{14})_([a-z0-9_]+)\.exs$ ]] ||
      fail "$file on the merged tree is not priv/repo/migrations/<14 digits>_<name>.exs, the only form this check reads: teach scripts/merge-pr that form"
    version=${BASH_REMATCH[1]}
    name=${BASH_REMATCH[2]}
    [[ -z ${versions[$version]:-} ]] ||
      fail "$file and ${versions[$version]} share the migration version $version on the merged tree: Ecto raises when both are pending, and a database that recorded $version never runs the other one. $(migration_fix "$file" "${versions[$version]}" "give the one origin/main lacks a version after the newest on origin/main, drop the test databases as docs/agents/testing.md says, run mix test, push, wait for CI")"
    [[ -z ${names[$name]:-} ]] ||
      fail "$file and ${names[$name]} share the migration name $name on the merged tree: Ecto raises when both are pending. $(migration_fix "$file" "${names[$name]}" "rename the one origin/main lacks, and its module, run mix test, push, wait for CI")"
    versions[$version]=$file
    names[$name]=$file
    count=$((count + 1))
  done <<<"$listing"
  ((count > 0)) || fail "no migration under priv/repo/migrations on the merged tree"
  echo "migrations: $count, no version or name twice"
}

check_against_main
check_skip

# 7. The fences on the merged tree. fences_tree is the merged tree they last passed on, so a 405
# retry re-runs them only when origin/main moved to a different merged tree.
fences_tree=
check_fences() {
  if [[ $tree == "$fences_tree" ]]; then
    echo "fences: the merged tree is unchanged since they passed"
    return
  fi
  scripts/merge-fences "$sha" "$main_sha" || exit 1
  fences_tree=$tree
}

payload=$(jq -nc --arg style "$style" --arg sha "$sha" \
  '{Do: $style, head_commit_id: $sha, delete_branch_after_merge: true}')
if [[ $style == squash ]]; then
  # main's convention: the PR title with (#n), then the body of the PR's fix commit: the
  # branch's only commit, --body-from's, or --body-file's text.
  [[ $title == *"(#$pr)" ]] || title="$title (#$pr)"
  commits=$(git rev-list --reverse --no-merges "$main_sha..$sha")
  [[ -n $commits ]] || fail "#$pr has no commit that origin/main lacks"
  if [[ -n $body_file ]]; then
    echo "squash body from: --body-file $body_file"
    message=$body_text
  else
    if [[ -n $body_from ]]; then
      body_commit=$(git rev-parse --verify -q "$body_from^{commit}") || fail "--body-from: $body_from is not a commit"
      grep -qx "$body_commit" <<<"$commits" ||
        fail "--body-from: $body_from is not one of #$pr's non-merge commits (origin/main..$sha)"
      echo "squash body from: $(git log -1 --format='%h %s' "$body_commit")"
    else
      body_commit=$(sed -n 1p <<<"$commits")
      # With review or CI commits after it, the first commit's message can describe a diff the
      # PR no longer has (#1014, #1089), so the caller picks the body after reading it.
      count=$(wc -l <<<"$commits")
      if ((count > 1)); then
        echo "#$pr has $count non-merge commits:" >&2
        git log --no-walk=unsorted --format='  %h %s' --stdin <<<"$commits" >&2
        echo "The first one's message:" >&2
        git log -1 --format=%B "$body_commit" | sed 's/^/  | /' >&2
        fail "read that message against the final diff, then pass --body-from=$(git rev-parse --short "$body_commit") to keep it, --body-from=<another listed sha>, or --body-file=<file> with a body that describes the final diff"
      fi
      echo "squash body from: $(git log -1 --format='%h %s' "$body_commit") (override with --body-from=<sha> or --body-file=<file>)"
    fi
    message=$(git log -1 --format=%b "$body_commit")
  fi
  payload=$(jq -c --arg t "$title" --arg m "$message" \
    '. + {MergeTitleField: $t, MergeMessageField: $m}' <<<"$payload")
fi

check_fences

if $dry_run; then
  echo "would POST /pulls/$pr/merge with:"
  jq . <<<"$payload"
  echo "DRY RUN: every check passed; #$pr ($sha) would merge with $style"
  exit 0
fi

# 15 retries 20 s apart wait 5 minutes; counting retries rather than seconds keeps check 7's
# minutes out of that wait.
retries=0
while :; do
  api POST "/pulls/$pr/merge" "$payload"
  case $http_status in
    200) break ;;
    405)
      reason=$(jq -r '.message // empty' <<<"$http_body" 2>/dev/null || true)
      ((retries < 15)) || fail "Forgejo still answers 405 after 15 retries 20 s apart: ${reason:-$http_body}"
      retries=$((retries + 1))
      echo "405 (${reason:-no message}); retry $retries of 15 in 20 s"
      sleep 20
      fetch_head
      check_against_main
      check_skip
      check_fences
      ;;
    409) fail "409: the branch moved after CI ran on $sha" ;;
    *) fail "POST /pulls/$pr/merge answered $http_status: $http_body" ;;
  esac
done

api GET "/pulls/$pr"
[[ $(jq -r .merged <<<"$http_body") == true ]] || fail "#$pr does not report merged after a 200"
echo "MERGED: #$pr as $(jq -r .merge_commit_sha <<<"$http_body")"
