#!/usr/bin/env bash
# Seed a fresh worktree with the main checkout's deps/ and _build/test, then fetch what it lacks.
#
#   scripts/seed-worktree
#
# Run it from inside the worktree (docs/agents/workflow.md "Worktrees"). It seeds the worktree it
# runs in, not the one holding the script, so a branch cut before the script existed can run the
# main checkout's copy. The main checkout is the one that owns the shared .git directory.
#
# It copies rather than symlinks, since a shared _build compiles one branch into another's tree.
# It leaves out what Cinder's own compile writes (_build/test/lib/cinder and
# _build/test/phoenix-colocated/cinder), so the worktree compiles its own code and a mix test
# running in the main checkout cannot delete a file from under the copy. Each copy is built under
# _build/ and renamed into place once complete, so after a failed run (hex.pm down, a dependency
# file vanishing mid-copy) the next run keeps what is complete and redoes the rest. The rename
# fails rather than nesting when the destination appeared meanwhile.
#
# Before the copies, it writes Cinder's pre-push runner into the hooks folder that every checkout
# of the repo shares, the hooks folder of the shared .git directory. The runner runs the pushing
# checkout's .githooks/pre-push and exits 0 in a checkout without one, such as a branch cut before
# the hook existed. The script leaves core.hooksPath alone, since pointing it at .githooks would
# switch off the other hooks in that folder (graphify's). When core.hooksPath is set, git looks
# for hooks where that setting says, so the script writes no runner and prints a WARNING line. It
# also keeps a pre-push hook in that folder that lacks the runner's marker line, with a WARNING
# line.
#
# It then runs the two audits of CI's dependency-audit job, `mix hex.audit` and `mix deps.audit`,
# in the test env. When one fails, it prints that audit's output and ends on a WARNING line, still
# with exit 0: an advisory or a retired package published after main's last green run turns that
# job red on every PR (on #855, 31 minutes before CI showed it).
set -euo pipefail

usage() {
  sed -n '4p' "$0" | sed 's/^#   //' >&2
  exit 2
}

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

[[ $# -eq 0 ]] || usage

root=$(git rev-parse --show-toplevel)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
main_checkout=$(dirname "$common_dir")
real_root=$(cd "$root" && pwd -P)
real_main_checkout=$(cd "$main_checkout" && pwd -P)

if [[ $real_root == "$real_main_checkout" ]]; then
  fail "$root is the main checkout; run this in a worktree"
fi
for dir in deps _build/test/lib; do
  [[ -d $main_checkout/$dir ]] || fail "the main checkout has no $dir; run mix test in $main_checkout first"
done

cd "$root"

runner_mark="# Cinder's pre-push runner, written by scripts/seed-worktree."
if hooks_path=$(git config core.hooksPath); then
  echo "WARNING: core.hooksPath is set ($hooks_path); wrote no pre-push runner"
else
  hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-push"
  if [[ -e $hook ]] && ! grep -qxF "$runner_mark" "$hook"; then
    echo "WARNING: kept $hook, which is not Cinder's runner, so a push skips .githooks/pre-push"
  else
    mkdir -p "$(dirname "$hook")"
    staged="$hook.$$"
    printf '%s\n' '#!/bin/sh' "$runner_mark" '[ -e .githooks/pre-push ] || exit 0' \
      'exec .githooks/pre-push "$@"' > "$staged"
    chmod 755 "$staged"
    mv -f "$staged" "$hook"
  fi
fi

mkdir -p _build
rm -rf _build/deps.partial _build/test.partial

if [[ -e deps ]]; then
  echo "seed-worktree: deps already exists; kept"
else
  cp -a "$main_checkout/deps" _build/deps.partial
  mv -T _build/deps.partial deps
fi

if [[ -e _build/test ]]; then
  echo "seed-worktree: _build/test already exists; kept"
else
  mkdir _build/test.partial
  tar -C "$main_checkout/_build/test" --anchored \
    --exclude=./lib/cinder --exclude=./phoenix-colocated/cinder -cf - . |
    tar -C _build/test.partial -xf -
  mv -T _build/test.partial _build/test
fi

mix deps.get
echo "OK: seeded $root"

failed=""
for audit in hex.audit deps.audit; do
  if ! output=$(env MIX_ENV=test mix "$audit" 2>&1); then
    printf '%s\n' "$output"
    failed="${failed:+$failed and }mix $audit"
  fi
done
if [[ -n $failed ]]; then
  echo "WARNING: $failed failed on this mix.lock (output above). When it names an advisory or a" \
    "retired package, CI / dependency-audit is red on every PR until a fix merges: see" \
    "docs/agents/ci.md \"New advisory\"."
else
  echo "OK: mix hex.audit and mix deps.audit passed"
fi
